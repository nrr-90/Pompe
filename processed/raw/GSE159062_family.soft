^DATABASE = GeoMiame
!Database_name = Gene Expression Omnibus (GEO)
!Database_institute = NCBI NLM NIH
!Database_web_link = http://www.ncbi.nlm.nih.gov/geo
!Database_email = geo@ncbi.nlm.nih.gov
^SERIES = GSE159062
!Series_title = Transcriptomic profile of three-dimensional tissue-engineered human skeletal muscle model of Pompe disease and recombinant protein therapy
!Series_geo_accession = GSE159062
!Series_status = Public on Oct 06 2020
!Series_submission_date = Oct 05 2020
!Series_last_update_date = Nov 01 2021
!Series_pubmed_id = 33953320
!Series_summary = Pompe disease (glycogen storage disease type II, or acid maltase deficiency) is an autosomal-recessive disorder of metabolism caused by mutations in the lysosomal hydrolase, acid alpha-glucosidase gene (GAA), resulting in progressive muscle atrophy. The current standard of care treatment, enzyme replacement therapy, consists of delivering recombinant human GAA (rhGAA) to reduce muscle glycogen and improve patient quality of life.  With the aim of developing in vitro systems to study human disease and test therapies, we applied RNA sequencing to 3D tissue-engineered human skeletal muscle to compare healthy, (infantile onset) Pompe disease, and rhGAA-treated Pompe engineered tissues.
!Series_overall_design = High throughput sequencing of RNA obtained from healthy, Pompe disease, rhGAA treated Pompe disease engineered skeletal muscle
!Series_type = Expression profiling by high throughput sequencing
!Series_contributor = Nenad,,Bursac
!Series_contributor = Jason,,Wang
!Series_contributor = Dwight,D,Koeberl
!Series_contributor = Priya,S,Kishnani
